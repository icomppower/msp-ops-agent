# MongoDB Atlas (M10+, MongoDB 8.0; needs Atlas Search + Vector Search)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/msp_ops?retryWrites=true&w=majority
MONGODB_DB=msp_ops

# Claude (Anthropic). Org-level keys also need ANTHROPIC_WORKSPACE_ID.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-opus-5-5

# Embeddings: Voyage AI via Atlas AI Model APIs (primary). Leave the key empty
# to fall back to a local 384-dim MiniLM model (EMBED_PROVIDER=local forces it).
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://ai.mongodb.com
VOYAGE_MODEL=voyage-4-large
EMBED_PROVIDER=auto

# Optional: ElevenLabs spoken summary of each revision (rendered only when both are set)
VOICE_ENABLED=false
ELEVENLABS_API_KEY=

# Queryable Encryption local KMS master key: 96 random bytes, base64.
#   node -e 'console.log(require("crypto").randomBytes(96).toString("base64"))'
QE_LOCAL_MASTER_KEY=
